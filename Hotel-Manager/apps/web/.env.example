# ===================================================
# Hotel Management System — Frontend Environment
# Copy this to .env and fill in your values
# ===================================================

# Backend API URL
VITE_API_URL="http://localhost:3000/api/v1"

# WebSocket URL (for Socket.IO)
VITE_SOCKET_URL="http://localhost:3000"

# Stripe Publishable Key (safe to expose — never use secret key here)
# Get from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Sign-in (Google / Apple only). Use the SAME values as the API's GOOGLE_CLIENT_ID /
# APPLE_CLIENT_ID. A provider whose ID is unset is hidden on the login page.
VITE_GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
VITE_APPLE_CLIENT_ID=""
# Return URL registered on the Apple Services ID (default: <current origin>/login)
VITE_APPLE_REDIRECT_URI=""

# App metadata
VITE_APP_NAME="Hotel Manager"
VITE_APP_VERSION="1.0.0"
