# ===================================================
# Hotel Management System — Backend Environment
# Copy this to .env and fill in your values
# ===================================================

# DATABASE (Supabase PostgreSQL)
# Get from: Supabase Dashboard > Project Settings > Database
# DATABASE_URL = the connection the running app uses (pooled is fine).
# DIRECT_URL   = a DIRECT (non-pooled, port 5432) connection used by `prisma migrate deploy`.
#                Required — the Prisma schema declares `directUrl = env("DIRECT_URL")`.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# SUPABASE
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_KEY="eyJhbGci..."
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# JWT
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-min-32-chars-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-different-min-32-chars-string"
JWT_REFRESH_EXPIRES_IN="7d"

# SIGN-IN (Google / Apple only — there is no password login)
# Users must already exist (admins add them by email); the first sign-in links the
# provider account by verified email. Comma-separate to accept several client IDs.
# Google: Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
#   Authorized JavaScript origins: http://localhost:5173 and the deployed web app origin.
GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# Apple: Developer > Identifiers > Services IDs (Sign in with Apple enabled). The
#   Services ID (e.g. com.cestlastay.signin) is the client ID. Register the web
#   app domain + return URL (https://<web-app>/login). Apple does not allow localhost.
APPLE_CLIENT_ID=""

# STRIPE
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# SENDGRID EMAIL
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@yourhotel.com"
SENDGRID_FROM_NAME="Hotel Manager"

# SendGrid dynamic template IDs (create in SendGrid UI)
SENDGRID_TEMPLATE_BOOKING_CONFIRMATION=""
SENDGRID_TEMPLATE_CHECK_IN_REMINDER=""
SENDGRID_TEMPLATE_LOYALTY_DISCOUNT=""

# TWILIO SMS (Optional)
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1234567890"

# APP SETTINGS
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# CORS — comma-separated list of allowed browser origins (HTTP + WebSocket).
# In production set BOTH deployed frontends (admin/web AND guest landing), e.g.:
#   CORS_ORIGINS="https://cestlastay.com,https://app.cestlastay.com"
# If unset, falls back to FRONTEND_URL + localhost:5173 + localhost:5174.
CORS_ORIGINS=""

# TAX RATE (percentage, e.g. 10 = 10%)
TAX_RATE=10

# RESEND — inbound email forwarding (stay@cestlastay.com -> team inboxes)
# API key: https://resend.com/api-keys  ·  Webhook secret: Resend -> Webhooks -> endpoint
#   Webhook URL: https://<api-host>/api/v1/webhooks/resend  (event: email.received)
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# Comma-separated list of inboxes that receive stay@ mail
RESEND_FORWARD_TO=""
RESEND_FORWARD_FROM="C'est La Stay Inbox <stay@cestlastay.com>"
